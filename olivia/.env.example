# Copia este archivo a .env y rellena las claves. NUNCA subas .env a GitHub.
ANTHROPIC_API_KEY=
OLIVIA_MODEL=claude-sonnet-5-5
# Nivel de razonamiento del modelo: low (más rápido, recomendado), medium o high
OLIVIA_EFFORT=low
# Pon OLIVIA_AI_MOCK=1 para desarrollar sin gastar créditos (respuesta simulada)
OLIVIA_AI_MOCK=0

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
